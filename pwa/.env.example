# CV Optimizer Pro PWA - Environment Variables
# Copy this file to .env and fill in your actual values

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Stripe Payment Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Flask Configuration
SESSION_SECRET=your_session_secret_key_here
FLASK_ENV=development

# PWA Configuration
PWA_SHORT_NAME=CV Optimizer
PWA_NAME=CV Optimizer Pro
PWA_DESCRIPTION=Profesjonalne narzędzie AI do optymalizacji CV
PWA_THEME_COLOR=#667eea
PWA_BACKGROUND_COLOR=#667eea