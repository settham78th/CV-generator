modules = ["python-3.11", "web", "nodejs-20", "postgresql-16", "python3"]
run = "python app.py"

[nix]
channel = "stable-24_05"
packages = ["openssl", "postgresql", "zip"]

[deployment]
run = ["sh", "-c", "gunicorn main:app"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80

[[ports]]
localPort = 5002

[[ports]]
localPort = 5003
externalPort = 5173
