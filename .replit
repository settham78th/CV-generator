modules = ["python-3.11", "web", "nodejs-20", "postgresql-16", "python3"]
run = "python app.py"

[nix]
channel = "stable-24_05"
packages = ["openssl", "postgresql"]

[deployment]
run = ["sh", "-c", "gunicorn main:app"]

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 43010371
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
